DATABASE_URL=postgresql+psycopg://transaction_user:transaction_password@postgres:5432/transactions
REDIS_URL=redis://redis:6379/0
APP_ENV=local
LOG_LEVEL=INFO
TRANSACTION_PROCESSING_DELAY_SECONDS=30
PROCESSING_LEASE_SECONDS=90
OUTBOX_DISPATCH_INTERVAL_SECONDS=2
OUTBOX_BATCH_SIZE=100
WEBHOOK_SIGNATURE_ENABLED=false
WEBHOOK_SIGNATURE_SECRET=

